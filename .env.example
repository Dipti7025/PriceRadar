# ==============================================================================
# PriceRadar Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# Note: PostgreSQL is REQUIRED. SQLite is NEVER used.

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=True
APP_NAME="PriceRadar API"
APP_VERSION="1.0.0"

# --- Backend Server ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- PostgreSQL Database (Strictly PostgreSQL - No SQLite fallback) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=priceradar

# Async connection string for FastAPI/SQLAlchemy 2.0 (asyncpg)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Sync connection string for Alembic migrations (psycopg2)
DATABASE_SYNC_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- SSRF & Security ---
# Comma-separated list of additional allowed hosts (empty allows public non-private IPs)
ALLOWED_SCRAPE_DOMAINS=
# Maximum redirects allowed during URL fetching (SSRF prevention)
MAX_FETCH_REDIRECTS=3
# Request timeout in seconds
FETCH_TIMEOUT_SECONDS=10

# --- Worker & Automation Settings ---
WORKER_POLL_INTERVAL_SECONDS=60
HEADLESS_BROWSER=True
USER_AGENT="PriceRadar/1.0 (+https://github.com/priceradar; legitimate price comparison crawler)"
